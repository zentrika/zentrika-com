# Zentrika.com — variables de entorno. Copia a .env.local (desarrollo) o define en el despliegue.
# URL pública del sitio (canónicas, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
# API pública de ZentrikaOS vista desde el NAVEGADOR (formularios, imágenes)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100
# API pública de ZentrikaOS vista desde el SERVIDOR de Next.js (en Docker: http://host.docker.internal:8100)
ZENTRIKAOS_API_URL=http://127.0.0.1:8100
# Secreto compartido con ZentrikaOS (WEB_REVALIDATE_SECRET) para la revalidación bajo demanda. Opcional.
REVALIDATE_SECRET=
